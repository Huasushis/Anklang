# Anklang 环境变量参考。
# 程序不会自动读取本文件；请由进程管理器或部署平台注入变量。
# 真实密钥只应由安全的密钥管理机制提供，不写入仓库、镜像或日志。
# 布尔值只能留空，或填写小写 true/false；其他写法会拒绝启动。

# ---- 服务本身 ----
# 默认只允许本机访问；容器内部由 Compose 显式设为 0.0.0.0
ANKLANG_BIND_HOST=127.0.0.1
# 监听端口，默认 8730
ANKLANG_PORT=8730
# 与调用方约定的服务令牌，至少 16 个字符；留空表示不启用 Bearer 鉴权
ANKLANG_SERVICE_TOKEN=
# 生产环境设为 true；缺少或过短的令牌会使服务拒绝启动
ANKLANG_REQUIRE_SERVICE_TOKEN=false
# 同时进入鉴权、正文读取和后端检索的请求上限，范围 1..256
ANKLANG_MAX_IN_FLIGHT_CHECKS=16
# 客户端连续不发送正文数据多久后断开，单位秒，范围 1..300
ANKLANG_CLIENT_IDLE_TIMEOUT_SECONDS=15
# 收到 SIGTERM/SIGINT 后等待在途请求结束的最长时间，范围 1..300 秒
ANKLANG_SHUTDOWN_GRACE_SECONDS=30
# 仅供 Compose 使用；必须始终大于应用停止宽限
ANKLANG_STOP_GRACE_PERIOD=45s

# ---- 检索参数 ----
# 每次检索使用的候选数量，范围 1..20
ANKLANG_SEARCH_K=8
# 低于此相似度的候选不展示，范围 0..1；不是业务判定阈值
ANKLANG_MINIMUM_SIMILARITY=0.5

# ---- 本地检索 ----
# SQLite 是 Python 自带的单文件数据库；路径相对于启动目录
ANKLANG_LOCAL_DB_PATH=problems-data/local-index.db

# ---- embedding 提供方 ----
# base URL 必须包含 /compatible-mode/v1；URL 或密钥缺失时查询明确返回不可用
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIM=1024

# ---- 来源导入 ----
# 是否在服务运行时定期调用已安装的来源模块；默认关闭
ANKLANG_INGEST_ENABLED=false
# 增量抓取间隔，范围 60..86400 秒
ANKLANG_INGEST_INTERVAL_SECONDS=3600

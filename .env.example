# Anklang 环境变量字段与默认值参考。
# 程序不会自动读取本文件。真实密钥必须放在仓库外，由部署平台或进程管理器传给进程；
# 不要用 shell 的 source 或 . 加载密钥文件，避免特殊字符导致密钥被回显。
# 所有密钥只读入内存，不写日志、健康检查或错误响应。
# 所有开关只能留空，或填写小写 true/false；其他写法会使服务拒绝启动。

# ---- 服务本身 ----
# 监听地址默认只允许本机访问；仅容器内部需要显式改为 0.0.0.0
ANKLANG_BIND_HOST=127.0.0.1
# 监听端口，默认 8730
ANKLANG_PORT=8730
# 与 Urmotiv 插件密钥一致的服务令牌，至少 16 字符；留空则不校验（仅限完全内网可信环境）
ANKLANG_SERVICE_TOKEN=
# 生产环境必须设为 true；打开后，缺少或过短的令牌会让服务拒绝启动
ANKLANG_REQUIRE_SERVICE_TOKEN=false
# 同时进入鉴权、正文读取和后端检索的查重请求上限，范围 1..256
ANKLANG_MAX_IN_FLIGHT_CHECKS=16
# 客户端连续不发送正文数据多久后断开，单位秒，范围 1..300
ANKLANG_CLIENT_IDLE_TIMEOUT_SECONDS=15
# 收到 SIGTERM/SIGINT 后等待在途请求结束的最长时间，单位秒，范围 1..300
ANKLANG_SHUTDOWN_GRACE_SECONDS=30
# 仅供 Compose 使用；必须始终大于上面的应用停止宽限
ANKLANG_STOP_GRACE_PERIOD=45s

# ---- yuantiji.ac 上游 ----
YUANTIJI_BASE_URL=https://yuantiji.ac
YUANTIJI_TIMEOUT_SECONDS=12
# 对上游的最小请求间隔（秒），对个人自费维护的服务保持克制
YUANTIJI_MINIMUM_INTERVAL_SECONDS=2
# 暂时性失败时最多再试几次；默认只再试一次
YUANTIJI_MAX_RETRIES=1
# 再试之前等待的秒数；后续每次等待会逐步增加
YUANTIJI_RETRY_BASE_DELAY_SECONDS=0.5
# 连续失败达到此次数后，暂时停止访问上游
YUANTIJI_CIRCUIT_FAILURE_THRESHOLD=3
# 暂停多少秒后允许重新尝试
YUANTIJI_CIRCUIT_OPEN_SECONDS=60
# 健康检查结果保留多少秒，避免检查本身频繁访问上游
YUANTIJI_HEALTH_CACHE_SECONDS=60
# 本地排队、上游等待、再次尝试、请求间隔、本地文字转数字和可选模型复核
# 合计最多允许 100 秒，
# 调用方超时必须设置为至少 120 秒，才能为处理与传输留出时间
# 这是按配置数值计算的限制；如果对方故意持续、极慢地传输少量数据，
# Python 标准库不能保证在某个墙钟时刻强制切断连接
# 每次检索返回的候选数量
ANKLANG_SEARCH_K=8
# 是否请求 yuantiji 的重排（更准但更慢/更贵）
ANKLANG_USE_RERANK=false
# 低于此相似度的候选不展示给用户
ANKLANG_MINIMUM_SIMILARITY=0.5
# 未用足够人工标注数据验证前保持 false；默认不会只凭相似度数字拦截投稿
ANKLANG_SIMILARITY_BLOCK_ENABLED=false
# 只有上面的开关明确打开后，此值才用于判断是否建议不要提交
ANKLANG_BLOCK_THRESHOLD=0.93

# ---- 结果缓存 ----
ANKLANG_CACHE_TTL_SECONDS=86400
ANKLANG_CACHE_MAX_ENTRIES=500

# ---- 可选：LLM 复核最相似的前 N 组是否同题 ----
ANKLANG_LLM_REVIEW=false
# OpenAI 兼容接口，baseUrl 需包含到 /v1
ANKLANG_LLM_BASE_URL=
ANKLANG_LLM_API_KEY=
ANKLANG_LLM_MODEL=deepseek-v4-flash
ANKLANG_LLM_REVIEW_TOP_N=2
ANKLANG_LLM_TIMEOUT_SECONDS=30

# ---- 可选：阶段 2 本地检索 ----
# reverse_proxy：把请求转发给 yuantiji.ac；local_engine：查询本地 SQLite 题库
ANKLANG_BACKEND=reverse_proxy
# SQLite 是 Python 自带的单文件数据库；此路径相对于启动目录
ANKLANG_LOCAL_DB_PATH=problems-data/local-index.db
ANKLANG_LOCAL_VECTOR_TOP_K=20
ANKLANG_LOCAL_KEYWORD_TOP_K=20

# 可选：把题面转换成数字列表，用来比较文字含义是否相近
# base URL 需要包含 /compatible-mode/v1；密钥留空时会退化成只做字面搜索
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIM=1024

# ---- 可选：阶段 3 来源导入 ----
# 是否在服务运行时定期调用已安装的来源模块；默认关闭
ANKLANG_INGEST_ENABLED=false
ANKLANG_INGEST_INTERVAL_SECONDS=3600
